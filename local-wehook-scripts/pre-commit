cat pre-commit
#!/bin/sh

echo "----------------------------------------"
echo "Running local Pre-commit Security Checks..."
echo "----------------------------------------"

# 1. Έλεγχος αν το Docker λειτουργεί
if ! docker info > /dev/null 2>&1; then
    echo "[!] ERROR: Docker daemon is not running."
    echo "[!] Please start Docker and try your commit again."
    exit 1
fi

# Εκτέλεση του Gitleaks μέσω Docker container
echo "[*] Scanning for hardcoded secrets with Gitleaks..."
docker run --rm -v "$(pwd)":/path zricethezav/gitleaks:latest dir /path -v
GEXIT=$?

# (Exit Codes)
if [ $GEXIT -eq 0 ]; then
    echo "[+] Gitleaks: No secrets found. Check passed!"
elif [ $GEXIT -eq 1 ]; then
    echo "----------------------------------------"
    echo "[!] SECURITY ERROR: Gitleaks detected secrets/credentials in your code!"
    echo "[!] Commit REJECTED. Remove the secrets before committing."
    echo "----------------------------------------"
    exit 1
else
    echo "----------------------------------------"
    echo "[!] ERROR: Gitleaks container failed to run properly (Exit code: $GEXIT)."
    echo "[!] Check your internet connection or docker image availability."
    echo "----------------------------------------"
    exit 1
fi

echo "[+] All local pre-commit checks passed successfully!"
exit 0